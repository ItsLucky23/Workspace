# ─────────────────────────────────────────────────────────────────────────────
# .env — PRODUCTION baseline. COMMITTED to git.
#
# MENTAL MODEL (secret-manager driven):
#   Every secret is resolved at RUNTIME by @luckystack/secret-manager from the
#   server at LUCKYSTACK_SECRET_MANAGER_URL. This file therefore holds only:
#     • secret-manager POINTERS  (shape <NAME>_V<n> — never a literal secret), and
#     • non-secret config.
#   So it is safe to commit. NO literal API keys / passwords / tokens live here.
#
#   .env.local (GITIGNORED) is loaded AFTER this file and OVERRIDES it. It carries
#   the local DEV values (NODE_ENV=development, SECURE=false, localhost, tunnel
#   ports, Windows paths) and any literal secret that is not yet a pointer.
#
#   A production deploy ships ONLY this file → it runs as production. A dev machine
#   also has .env.local → it runs as development. Run LUCKYSTACK_ENV_DEBUG=1 to list
#   any key set in both files (intended only for the deliberate dev overrides).
# ─────────────────────────────────────────────────────────────────────────────

# Runtime mode — PRODUCTION here; .env.local flips these to dev on a dev machine.
NODE_ENV=production
SECURE=true
# Bind address: 0.0.0.0 in containers/prod. Dev overrides to 127.0.0.1 in .env.local.
SERVER_IP=0.0.0.0

# Public app URL — the prod origin where users browse (post-login landing, email
# links, CORS). In dev it's derived from the Vite server, so .env.local leaves it
# unset. Set your real domain for production:
# PUBLIC_URL=https://workspace.keetlerop.nl

# CORS — provider origins for OAuth callbacks (public + backend origins auto-included).
EXTERNAL_ORIGINS=https://accounts.google.com,https://github.com,https://discord.com

# Redis-key namespace prefix.
PROJECT_NAME=Workspace

# ── Secret manager — resolves every <NAME>_V<n> pointer below at boot ──────────
LUCKYSTACK_SECRET_MANAGER_URL=https://secretmanager.workspace.keetlerop.nl

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=DATABASE_URL_V2

# ── Redis connection ──────────────────────────────────────────────────────────
# REDIS_USER/PASSWORD apply to both envs (password is a pointer). The prod HOST/PORT
# are deployment-specific — set them here for prod; dev uses the tunnel in .env.local.
REDIS_USER=root
REDIS_PASSWORD=REDIS_PASSWORD_V1
# REDIS_HOST=<prod redis host>
# REDIS_PORT=6379

# ── AI / media providers ──────────────────────────────────────────────────────
GEMINI_API_KEY=GEMINI_API_KEY_V1
FAL_KEY=FAL_KEY_V1
ELEVENLABS_KEY=ELEVENLABS_KEY_V1
SUNO_KEY=SUNO_KEY_V1

# ── OAuth login providers ─────────────────────────────────────────────────────
# DEV_* pointers are read when NODE_ENV != production (i.e. on dev machines). In
# PRODUCTION the framework reads the UNPREFIXED pair — add those pointers when the
# prod OAuth clients exist (until then, social login is simply disabled in prod).
DEV_GOOGLE_CLIENT_ID=DEV_GOOGLE_CLIENT_ID_V1
DEV_GOOGLE_CLIENT_SECRET=DEV_GOOGLE_CLIENT_SECRET_V1
# GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID_V1
# GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET_V1
DEV_GITHUB_CLIENT_ID=DEV_GITHUB_CLIENT_ID_V1
DEV_GITHUB_CLIENT_SECRET=DEV_GITHUB_CLIENT_SECRET_V1
# GITHUB_CLIENT_ID=GITHUB_CLIENT_ID_V1
# GITHUB_CLIENT_SECRET=GITHUB_CLIENT_SECRET_V1

# ── Transactional email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=RESEND_API_KEY_V1
EMAIL_FROM=testt@resend.dev

# ── 2FA + at-rest encryption ──────────────────────────────────────────────────
WORKSPACES_ENC_KEY=WORKSPACES_ENC_KEY_V1
TOTP_ENCRYPTION_KEY=TOTP_ENCRYPTION_KEY_V1

# ── Publishing OAuth ──────────────────────────────────────────────────────────
YOUTUBE_CLIENT_ID=YOUTUBE_CLIENT_ID_V1
YOUTUBE_CLIENT_SECRET=YOUTUBE_CLIENT_SECRET_V1
# TikTok — set both to enable (empty = TikTok publishing off).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Web push / PWA (VAPID) ────────────────────────────────────────────────────
WS_VAPID_PUBLIC=WS_VAPID_PUBLIC_V1
WS_VAPID_PRIVATE=WS_VAPID_PRIVATE_V1
WS_VAPID_SUBJECT=mailto:admin@youcomm.nl
# Backend origin used to build the publishing OAuth redirect_uri. Prod = your
# domain; dev overrides to http://localhost in .env.local.
# WS_PUBLIC_URL=https://workspace.keetlerop.nl

# ── Workspaces infra (shared) ─────────────────────────────────────────────────
WS_NET=workspaces-net
WS_EDITOR_EDGE_AUTH=1
# Deployment-specific (Docker/Caddy/cookie-domain) — set for prod; dev in .env.local.
# WS_DOCKER_BIN=/usr/bin/docker
# WS_CADDY_ADMIN=http://localhost:2019
# WS_AUTH_DIR=/srv/workspace/data/_auth
# WS_COOKIE_DOMAIN=.workspace.keetlerop.nl
# WS_EDITOR_AUTH_BACKEND=<prod backend host:port>
