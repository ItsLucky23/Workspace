node_modules
dist
.eslintcache

# Local env model:
#   .env       = PRODUCTION baseline, COMMITTED. Holds only secret-manager POINTERS
#                (e.g. DATABASE_URL_V1, resolved at runtime) + non-secret config.
#                Never a literal secret. NODE_ENV=production, SECURE=true.
#   .env.local = local DEV OVERRIDES, GITIGNORED. NODE_ENV=development, SECURE=false,
#                dev-only infra (localhost, tunnel ports, Windows paths) and any
#                literal secret that isn't a pointer. Loaded after .env, overrides it.
.env.local

# @luckystack/secret-manager shared bearer token (single-line file, never commit).
.secret-manager-token

# Generated artifacts.
src/_sockets/apiTypes.generated.ts
src/_sockets/apiInputSchemas.generated.ts
src/docs/apiDocs.generated.json
src/docs/apiTypeDiagnostics.generated.json
server/prod/generatedApis*.ts

# `luckystack check-env` / `check-i18n` scan reports.
dump/

# AI browser-testing artifacts (agent-browser / Playwright / Chrome DevTools MCP).
.agent-browser/
.playwright-mcp/
test-results/
playwright-report/
.claude/settings.local.json
.claude/worktrees/

# Workspaces linked-repo clones (never commit cloned project code)
data/

# #7 self-host stack: secrets + local backups (never commit)
deploy/.env
deploy/backups/
