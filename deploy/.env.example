# Workspaces self-host env (#7). Copy to deploy/.env — bootstrap.sh generates the secret values for
# you on first run. The stores' connection details are injected by docker-compose (DATABASE_URL,
# REDIS_HOST/PORT); you only set the SECRETS + optional OAuth/email here.

# Compose and the image pin this too; explicit here so copied env files never imply development mode.
NODE_ENV=production

# Root-owned bootstrap/break-glass allowlist for GLOBAL host superadmins. Workspace owners/admins are
# tenant-only and never inherit this role. Comma-separated; remove after persisting User.admin if desired.
WS_SUPERADMIN_EMAILS=

# Unrestricted Compose is NEVER sent to this app container's host Docker socket. Point this template at
# operator-provisioned per-workspace VM/microVM sandboxes; {workspaceId} is mandatory.
WS_COMPOSE_RUNNER_URL_TEMPLATE=

# --- Secrets (bootstrap.sh generates these; keep them safe — see docs/DR_RUNBOOK.md) ---
# Redis password (also consumed by the redis service in docker-compose).
REDIS_PASSWORD=
# App-owned encryption key for secrets at rest (GitLab/forge tokens, editor profiles). LOSING THIS
# MAKES ALL ENCRYPTED SECRETS UNRECOVERABLE — back it up separately from the data (DR_RUNBOOK §3).
WORKSPACES_ENC_KEY=
# Bearer credential for WS_COMPOSE_RUNNER_URL_TEMPLATE.
WS_COMPOSE_RUNNER_TOKEN=
# Shared secret a forge must present on POST /webhooks/forge/<id> (unset ⇒ webhooks disabled).
WS_WEBHOOK_SECRET=
# Web-push VAPID keypair (phone push notifications). bootstrap.sh generates these on first run —
# without them push silently no-ops on every fresh install.
WS_VAPID_PUBLIC=
WS_VAPID_PRIVATE=
WS_VAPID_SUBJECT=

# --- Optional token budgets (#4 self-handoff; defaults 120000) ---
WS_TURN_TOKEN_BUDGET=
WS_ASSISTANT_TOKEN_BUDGET=

# --- Cost & backup safety nets ---
# Host-wide metered €-ceiling across ALL workspaces (pauseNew when reached; 0/empty = no cap).
WS_HOST_SPEND_CAP_EUR=
# Automatic DB backups: every N hours (default 24; 0 disables), keep-N files (default 7).
WS_BACKUP_INTERVAL_HOURS=
WS_BACKUP_KEEP=

# --- Optional OAuth / email (leave blank to disable) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=

# --- Public URL (your real host in production; used for OAuth callbacks + absolute links) ---
PUBLIC_URL=http://localhost
