# Local secrets. NOT checked into git. Copy this to `.env.local` and fill in.
#
# 👉 STEP-BY-STEP for EVERY value here (what's required, what's optional, where to get each key):
#    docs/SETUP_FROM_SCRATCH.md   (paid media/publishing detail: docs/KEY_SETUP_GUIDE.md)
#
# ONE FILE PER KEY: keep every key in EXACTLY ONE of `.env` / `.env.local`.
# `.env.local` is loaded AFTER `.env` and overrides it, so a key set in both
# means editing only one file has confusing effects: emptying the value in
# `.env.local` overrides `.env` (the value goes away), but DELETING the line in
# `.env.local` lets `.env`'s old value resurface. Secrets belong here, in
# `.env.local`, and NOT in `.env`. Run with LUCKYSTACK_ENV_DEBUG=1 to list any
# key that ended up in both files.

# Database connection used by Prisma. This is pre-filled for the provider you
# chose at scaffold time; the other formats are shown for when you switch.
DATABASE_URL="mongodb://localhost:27017/test?replicaSet=rs0&directConnection=true"
#   mongodb:    mongodb://root:PASSWORD@127.0.0.1:27017/test?authSource=admin&directConnection=true&replicaSet=rs0
#               (Prisma needs a replica set — `rs0` here; for Atlas use the mongodb+srv URI it gives you)
#   postgresql: postgresql://user:password@localhost:5432/test
#   mysql:      mysql://user:password@localhost:3306/test
#   sqlite:     file:./dev.db

# Redis credentials (only required when your Redis instance has auth).
REDIS_USER=
REDIS_PASSWORD=

# ───────────────────────────────── OAuth ────────────────────────────────────
# OAuth client secrets. Just fill in a provider's id + secret and restart — the
# button appears on the login form automatically and its /auth/callback route
# works. No code edit needed: @luckystack/login/register already wires every
# built-in provider from env at boot. Providers you picked at scaffold time are
# uncommented; the rest are commented out — fill a pair and uncomment to enable
# later. DEV_* are read when NODE_ENV is not "production"; the unprefixed pair is
# read in production. A provider stays disabled until BOTH its id and secret are set.
#
# The login page reads GET /auth/providers, which lists a provider ONLY when BOTH
# its id and secret are non-empty. EMPTY a provider's id/secret here (and restart)
# → its button disappears from /login. (Make sure the same keys are not ALSO set
# in `.env`, or the button will stay — see the one-file-per-key note at the top.)
#
# IMPORTANT — Authorized redirect URI (fixes "Error 400: redirect_uri_mismatch"):
# /auth/callback/<provider> is a BACKEND route, so register the BACKEND origin in
# the provider's developer console (Google Cloud, GitHub OAuth App, …) — in dev
# that's SERVER_IP:SERVER_PORT:
#     http://localhost:80/auth/callback/google
# In production use your domain: https://your-domain.com/auth/callback/google
# It must match character-for-character (scheme, host, port). Also add the
# provider's origin to EXTERNAL_ORIGINS in `.env`.

# google (active)
DEV_GOOGLE_CLIENT_ID=
DEV_GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# github (active)
DEV_GITHUB_CLIENT_ID=
DEV_GITHUB_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# discord (active)
DEV_DISCORD_CLIENT_ID=
DEV_DISCORD_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# facebook (enable later)
# DEV_FACEBOOK_CLIENT_ID=
# DEV_FACEBOOK_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# microsoft (enable later)
# DEV_MICROSOFT_CLIENT_ID=
# DEV_MICROSOFT_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# ─────────────────────────── Transactional email ───────────────────────────
# Every provider is enable-later: install the package(s), set the keys, restart.
# The chosen adapter's keys are uncommented below; alternatives stay commented.

# Resend (active) — set your API key. Requires `npm i resend`.
# Also delivers the passwordless email-code login + the 2FA email fallback (ADR 0024). Without any email
# sender configured, @luckystack/email falls back to the CONSOLE sender (dev) which logs the code to stdout.
RESEND_API_KEY=

# 2FA (ADR 0024) — a long RANDOM string; encrypts TOTP secrets at rest (AES-256-GCM). Recommended when
# `auth.twoFactor` is enabled. Without it, secrets are stored plaintext (one-time boot warning). Use a random
# value, NOT a memorable passphrase (it is not a password).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=

# SMTP (enable later): npm i nodemailer, then set SMTP_HOST (+ user/pass).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Default From address for outgoing mail.
EMAIL_FROM=noreply@example.com

# ──────────────────────── Observability / error tracking ────────────────────
# Sentry + PostHog auto-wire from env at boot; Datadog needs the dd-trace block
# in server/server.ts uncommented (it must load before everything).
# Sentry (enable later): npm i @sentry/node, then set SENTRY_DSN + restart.
# SENTRY_DSN=
# SENTRY_ENABLED=false

# PostHog (enable later): npm i posthog-node, then set POSTHOG_KEY + restart.
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# Datadog (enable later): npm i dd-trace hot-shots, uncomment the dd-trace block
# in server/server.ts, then set DD_API_KEY (+ DD_SITE).
# DD_API_KEY=
# DD_SITE=datadoghq.com

# Test-only — protects /_test/reset in dev. Set this if you run integration tests.
TEST_RESET_TOKEN=

# ───────────────────────────────── Workspaces ───────────────────────────────
# App-owned encryption key for per-workspace secrets at rest (currently the GitLab
# token → Workspace.gitlabTokenEnc). Any string; it's hashed to a 32-byte AES-256-GCM
# key. Set a long random value BEFORE storing real credentials — without it, secrets are stored
# base64-plaintext with a boot warning (dev only). Can be a @luckystack/secret-manager pointer
# (WORKSPACES_ENC_KEY_V1). Generate:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
WORKSPACES_ENC_KEY=

# #10 Forge webhooks — shared secret a forge (GitLab/GitHub) must present in the
# `X-Webhook-Secret` (or GitLab's `X-Gitlab-Token`) header on POST /webhooks/forge/<workspaceId>.
# UNSET ⇒ the webhook endpoint is DISABLED (503, secure default). Set a long random value.
WS_WEBHOOK_SECRET=
# #4 Self-handoff token budgets (chars/4 estimate) — a worker/Assistant turn hands off + resets
# above this. Optional; defaults 120000. Per-stage override lives in the pipeline stage config.
WS_TURN_TOKEN_BUDGET=
WS_ASSISTANT_TOKEN_BUDGET=

# ── Content platform — media generation + publishing (Depth Program). All OPTIONAL: unset ⇒ the
# feature runs in safe dummy mode (stub assets, no billing). See docs/KEY_SETUP_GUIDE.md. WARNING:
# these bill real money per generation — set a media €-budget cap in Content → Settings first.
FAL_KEY=                       # images · video · 3D · reference-image (fal.ai)
ELEVENLABS_KEY=                # voiceover · sound effects
SUNO_KEY=                      # music
GEMINI_API_KEY=                # script writing · reference-video analysis (cheap; text only)
YOUTUBE_CLIENT_ID=             # publishing OAuth (Google Cloud console, youtube.upload scope)
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=             # publishing OAuth (TikTok developers, video.publish scope)
TIKTOK_CLIENT_SECRET=
# Cheapest-possible live test: forces schnell + lowest resolution + fewest steps (docs/KEY_SETUP_GUIDE.md).
WS_MEDIA_CHEAP=                # set to 1 to enable
# Optional render + model/cost overrides (defaults are sensible):
WS_FFMPEG_IMAGE=               # default jrottenberg/ffmpeg:latest (Docker render)
WS_MEDIA_DIR=                  # default data/media
FAL_MODEL_IMAGE_EDIT=          # F6 instruct-edit model (default fal-ai/flux-kontext/dev); FAL_COST_IMAGE_EDIT overrides its € estimate
# F3 scene-continuity: condition each generated scene on the PREVIOUS clip's last frame (needs an i2v FAL_MODEL_VIDEO).
WS_SCENE_CONTINUITY=           # set to on|1 to enable (default off = text-only continuity)
# Suno (music) — the API is api.sunoapi.org; model V5 = faster. Callback is unused (we poll) — any url ok.
SUNO_BASE=                     # default https://api.sunoapi.org/api/v1
SUNO_MODEL=                    # default V5 (V4 | V4_5 | V4_5PLUS | V4_5ALL | V5 | V5_5)
SUNO_CALLBACK_URL=             # default https://example.com/suno-callback (only to satisfy the API)
# fal poll budget — slow models (triposr 3D) need a higher ceiling; poll = FAL_POLL_MAX × FAL_POLL_MS.
FAL_POLL_MAX=                  # default 60 (bump to ~240 for reliable model-3d)
FAL_POLL_MS=                   # default 2000
# Web push / PWA (FREEDOM_PROGRAM A1) — self-hosted VAPID keypair.
# Generate a pair with:  node -e "console.log(require('web-push').generateVAPIDKeys())"
WS_VAPID_PUBLIC=               # the VAPID public key (also sent to the browser to subscribe)
WS_VAPID_PRIVATE=              # the VAPID private key (server-only; never exposed)
WS_VAPID_SUBJECT=              # a mailto: or https: contact url, e.g. mailto:you@example.com
# Host-wide metered €-ceiling across ALL workspaces (gap-fix): when total metered spend (media €-ledger
# + Gemini estimates) reaches this, new metered work pauses (pauseNew). 0/empty = no host cap.
WS_HOST_SPEND_CAP_EUR=
# Automatic DB backups (gap-fix, DR_RUNBOOK): interval in hours (default 24; 0 disables), keep-N files,
# and the target dir (default ./data/backups). Restore: npm run db:restore -- <file> --yes
WS_BACKUP_INTERVAL_HOURS=
WS_BACKUP_KEEP=
WS_BACKUP_DIR=
