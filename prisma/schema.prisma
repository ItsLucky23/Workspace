// Prisma schema — LuckyStack framework baseline (User) + the Workspaces V1 data model.
//
// Provider: MongoDB. Tenant = `Workspace`; every tenant-scoped model carries a
// `workspaceId` and goes through `runInTenant` + the graded clients (B-O8). The
// framework-global rows (`User`, `SshKey`, `PushSubscription`) carry NO
// `workspaceId` (04b §11b).
//
// Authority + provenance for the Workspaces block:
//   • src/workspaces/_docs/V1_SCOPE.md        — what ships (wins on conflict, §5)
//   • src/workspaces/_docs/04_DATA_MODEL.md    — §1 already-modeled · §2 new models · §3 field extensions
//   • src/workspaces/_docs/04b_DATA_MODEL_ADDENDA.md — §6–§17 build-grade bodies (transcribed here)
//   • src/workspaces/_docs/REFERENCE_CODES.md  — B-##/DH# binding definitions
//
// Deliberately ABSENT (recorded, not built — 04b §18 / V1_SCOPE §4): every built-in
// forge/MR/CI/auto-merge/preview-deploy/multi-provider surface. Do NOT add a model
// from 04b §18 to this file in V1.
//
// Design choices for this schema (see docs/decisions/0001-workspaces-v1-schema-shape.md):
//   1. Rich per-stage config is EMBEDDED as Prisma composite `type` blocks
//      (MongoDB-idiomatic), mirroring the prototype's flattened `PipelineStageCfg`
//      — not normalized into StageSkill/StageCommand/… child collections.
//   2. No separate `Pipeline` wrapper model — `PipelineStage` belongs to a `Project`
//      directly (the §18 CI `Pipeline` is deferred and name-clashes).
//   3. Models use loose `@db.ObjectId` reference fields, NOT formal Prisma
//      `@relation`s: delete-cascade (04b §11d) + tenant isolation are Conductor /
//      app-enforced, matching the single-writer + `$extends` where-injection model.
//   4. `User` is left untouched (the framework `defaultPrismaUserAdapter` contract);
//      no `OAuthAccount` model in V1 — framework auth + `User.provider` cover identity.
//   5. Growth-tolerant product fields (status/type/kind/…) are `String` + a
//      value-listing comment, verbatim from 04b, rather than Prisma enums — this
//      preserves prototype↔schema fidelity (`types.ts` uses the hyphenated literals)
//      and honors the docs' explicit "(+ growth)" intent.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Set during scaffold via `npx create-luckystack-app` interactive prompts.
  // To switch providers later, edit `provider` here and update DATABASE_URL.
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Framework-global identity (LuckyStack) — NO `workspaceId` (04b §11b)
// ============================================================================

enum LANGUAGE {
  en
  nl
  de
  fr
}

enum THEME {
  light
  dark
}

enum PROVIDERS {
  credentials
  google
  github
  discord
  facebook
  microsoft
}

// Recommended User model for LuckyStack's `defaultPrismaUserAdapter`. If your
// app's User model deviates, call `registerUserAdapter()` in
// `luckystack/server/index.ts` with a custom adapter instead of editing this.
model User {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  email           String
  password        String?
  provider        PROVIDERS @default(credentials)

  name            String?
  avatar          String    @default("")
  avatarFallback  String    @default("")
  admin           Boolean   @default(false)

  language        LANGUAGE  @default(en)
  theme           THEME     @default(light)

  //? Free-form per-user settings (notification opt-ins, etc.). Read/written by
  //? the settings/updatePreferences route and surfaced on the session.
  preferences     Json?

  //? TOTP 2FA (ADR 0024 / @luckystack/login) — all OPTIONAL + safe defaults, only touched when a user
  //? enrolls a second factor. `totpSecret` is AES-256-GCM-encrypted at rest when TOTP_ENCRYPTION_KEY is set;
  //? `recoveryCodes` are hashed. Stripped from the session by `sanitizeUserForSession`.
  twoFactorEnabled Boolean @default(false)
  totpSecret       String?
  recoveryCodes    Json?

  @@unique([email, provider])
}

//? SSH public key (B-05). Framework-global — a user's key, not a workspace's.
//? The linked public key is the capability-gate on the `/pty` namespace; the
//? private key never leaves the client (17_ACCOUNT_AND_AUTH). Prototype mirror:
//? `SshKeyEntry` (types.ts:199).
model SshKey {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId          // FRAMEWORK-GLOBAL (no workspaceId)
  name        String
  type        String                           // 'ed25519' | 'rsa' | ...
  fingerprint String
  publicKey   String                           // the public half; server verifies against it
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

//? Web-push registration (04b §10). FRAMEWORK-GLOBAL — a user's device, not a
//? workspace's (§11b). Redacted-push posture: `fullBodyOptIn` gates whether the
//? push payload may carry the full `Notification.body` (D80 REVERSED,
//? Q-SEC-NOTIF-PUSH).
model PushSubscription {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @db.ObjectId          // FRAMEWORK-GLOBAL (not tenant-scoped)
  endpoint      String    @unique                // the Web Push endpoint URL (unique per device → upsert-able)
  keys          Json                             // { p256dh, auth } — Web Push encryption keys (server-only secret)
  fullBodyOptIn Boolean   @default(false)         // D80 REVERSED: push is REDACTED by default; full body opt-in per device
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime?

  @@index([userId])
}

// ============================================================================
// Tenant root + identity/access (tenant-scoped)
// ============================================================================

//? The tenant (B-06). Everything else in this section carries its `workspaceId`.
//? Field sweep (04b §13): timezone/pricing/assistant+reasoner budget/
//? handoffInstruction/presetKey. GitLab token stored ENCRYPTED per workspace
//? (B-07). Preview-concurrency cap is OMITTED in V1 (preview-deploy is OUT,
//? V1_SCOPE §4) and lands the day that lane opens.
model Workspace {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  slug                  String
  ownerId               String   @db.ObjectId          // User.id (framework-global) — current owner (single-owner, D77)

  // --- Forge (GitLab default; #10 adds GitHub). The gitlab* fields are the generic forge
  //     base-url / token store despite their name (kept for back-compat). ---
  forgeType             String   @default("gitlab")      // #10 'gitlab' | 'github' — which forge provider
  gitlabUrl             String?                          // forge API base url (GitLab instance, or GitHub api base)
  gitlabTokenEnc        String?                          // ENCRYPTED per-workspace forge token (app-owned encryption v1)
  webhookSecret         String?                          // #27 — per-workspace inbound-webhook secret (the /webhooks/forge/<id> URL is per-workspace, so the secret is too). Verified by webhookRoute; rotatable via forge-webhook-rotate. null ⇒ falls back to env WS_WEBHOOK_SECRET
  webhookLastEventAt    DateTime?                        // #27 — timestamp of the last accepted inbound webhook (the settings-card "last event received" indicator)

  // --- settings / field sweep (04b §13) ---
  timezone              String   @default("UTC")         // D55 — IANA tz; anchors cron + budget window reset + sprint dates
  presetKey             String   @default("professional")// D1/D18 — 'simple'|'advanced'|'professional' (provenance only; tiers editable after)
  pricing               Json?                            // D31 — per-model price map (editable; zero-out → tokens-only cost chips)

  // --- workspace-AI budget + self-handoff (06, 04 §3) ---
  assistantTokenBudget  Int?                             // per-user-Assistant context budget → self-handoff
  reasonerTokenBudget   Int?                             // optional future one-shot reasoner budget
  handoffInstruction    String   @default("")            // the editable self-handoff instruction template
  productContext        String   @default("")            // Q2 — brand/product context (what we do / audience / always-mention), folded into every creative generation
  brandLogoUrl          String?                          // gap-fix — the brand logo (/media/… upload) the render watermark overlays (watermark fires only when a position is chosen)
  aiInstruction         String   @default("")            // Q4 — workspace-wide "how the AI should work here" instruction, prepended to EVERY AI completion's system prompt
  outputLanguage        String   @default("")            // K4 — preferred AI OUTPUT language (e.g. 'Dutch'); empty = the model's default. Prepended as a directive to every completion
  autonomyLevel         String   @default("gate-key-stages") // A4 — 'gate-every' | 'gate-key-stages' (default: per-stage gateForApproval) | 'full-auto' (skip non-destructive gates)
  geminiModel           String   @default("")            // P2 — per-workspace Gemini model override (empty = env/default). Claude-CLI has no model concept (PTY-billed)
  geminiTemperature     String   @default("")            // P2 — per-workspace Gemini temperature (empty = model default); string so empty is distinguishable from 0
  geminiBaseUrl         String   @default("")            // X4 — per-workspace custom Gemini base URL (empty = env/Google default); bring-your-own endpoint

  // --- git workflow config (hosting-proxy plan) ---
  gitConfig             Json?                            // per-workspace GitConfig (branchStrategy.ts): branch strategy + push/MR policy. null ⇒ DEFAULT_GIT_CONFIG (branch == ticket key)
  paused                Boolean  @default(false)          // pause-all: when true the engine provisions NO new autonomous turns (C2)
  allowMergeOnRedCI     Boolean  @default(false)          // ADR 0039 — Admin override: allow merge/promote while a required CI run is red (unwedges a broken runner)

  // --- module / nav-section gating (workspace scope). Resolved section-id list chosen
  //     at creation (from the Dev/Content/Design module presets) + toggled after.
  //     EMPTY = legacy / all-on (pre-module workspaces keep every section). See
  //     src/workspaces/_data/modules.ts for the module→section map. ---
  enabledSections       String[]                          // gateable nav-section ids that are ON; [] ⇒ all sections shown

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([ownerId])
  @@index([slug])
}

//? Workspace membership. `roleKey` references a `WorkspaceRole.key` (per-workspace,
//? replacing the fixed enum — 04b §11e). Prototype mirror: `Member` (types.ts:17).
model WorkspaceMember {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @db.ObjectId
  userId      String   @db.ObjectId          // User.id (framework-global)
  roleKey     String                          // → WorkspaceRole.key ('owner'|'admin'|'member' seeded; custom added)
  createdAt   DateTime @default(now())

  @@unique([workspaceId, userId])
  @@index([workspaceId])
}

//? Custom RBAC role (04b §11e, D76). `perms` is one boolean per RBAC_CAPABILITIES
//? entry (B-28 matrix, positional). Built-ins seeded per workspace (editable,
//? not deletable). Single-Owner invariant (D77) enforced in the membership
//? `preApiExecute` check, NOT by locking rows. Prototype mirror: `PermRole`
//? (types.ts:236).
model WorkspaceRole {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String    @db.ObjectId
  key         String                          // stable ref ('owner'|'admin'|'member' seeded; custom keys added)
  label       String                          // editable display name
  perms       Boolean[]                       // one boolean per RBAC_CAPABILITIES entry (positional)
  builtIn     Boolean   @default(false)       // seeded built-ins (cannot be deleted; CAN be edited per D76)
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

//? Pending email invite (B-06, via @luckystack/email). Prototype mirror:
//? `InviteEntry` (types.ts:217).
model Invite {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId  String   @db.ObjectId
  email        String
  roleKey      String                          // → WorkspaceRole.key to grant on accept
  invitedById  String?  @db.ObjectId           // User.id who sent it
  token        String                          // single-use accept token (crypto-random, unguessable)
  status       String   @default("pending")    // 'pending' | 'accepted' | 'revoked' | 'expired'
  createdAt    DateTime @default(now())
  expiresAt    DateTime?                        // F3 — invites lapse; an expired invite cannot be accepted
  acceptedAt   DateTime?

  @@unique([workspaceId, email])
  @@index([workspaceId, status])
}

// ============================================================================
// Project & pipeline (tenant-scoped)
// ============================================================================

//? A `{ path, role }` entry — GENERATE (framework writes docs here) vs LINK
//? (reference existing) — D9/D19.
type LinkedFile {
  path String
  role String        // 'generate' | 'link'
}

//? The linked repo + its build/image config. Field sweep (04b §13): gitUrl,
//? linkedFiles[], generatedDocsPath, baseImageRef(+dockerfilePath). Prototype
//? mirror: `Project` (types.ts:34).
model Project {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId       String       @db.ObjectId
  name              String
  projectType       String       @default("dev")            // ADR 0049 — 'dev' | 'content' (picks the workflow lane)
  gitlabPath        String                                    // e.g. "youcomm/app"
  gitUrl            String?                                    // the linked repo url (alongside gitlabPath)
  linkedFiles       LinkedFile[]                              // D9/D19 — GENERATE vs LINK
  generatedDocsPath String       @default("docs/luckystack/") // D21 — where GENERATE'd docs are committed
  baseImageRef      String?                                    // Q-CT-IMAGESEL — L2 per-project image selector (default = framework base, P2)
  stack             String?                                    // S1/E1 — 'node'|'python'|'go'|'rust'|'java'|'php'|'dotnet'|'ruby'|'generic' → the L1 base image when no baseImageRef (any-stack); null = node
  dockerfilePath    String?                                    // optional per-project Dockerfile
  devCommand        String?                                    // the command that starts the app's dev server in the ticket container (preview flow); default = package.json scripts.dev
  prodCommand       String?                                    // D1 — the production serve command for prod/demo envs (build then serve); default = the stack's prod command
  allowCustomBase   Boolean  @default(false)                   // E2 — expert opt-in: allow an arbitrary Dockerfile FROM (agent/editor features may be degraded)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([workspaceId])
}

//? A build+deploy unit WITHIN a project — the monorepo-with-services granularity
//? (ADR 0035, item A1 step (b)). A project holds N services; each is independently
//? buildable / deployable / previewable. A single-service repo needs NO explicit
//? Service row (the project root IS the unit); services are additive granularity for
//? monorepos. `workspaceId` is denormalized for `runInTenant` row-isolation (B-O8).
model Service {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId  String   @db.ObjectId
  projectId    String   @db.ObjectId
  name         String
  path         String   @default(".")           // repo-relative root of this service
  buildCmd     String?                            // build command (null ⇒ inherit project/default)
  deployUnit   String?                            // deployable-artifact name (null ⇒ = name)
  baseImageRef String?                            // per-service image override (falls back to Project.baseImageRef)
  devCommand   String?                            // dev-server command for preview (falls back to Project.devCommand)
  prodCommand  String?                            // D1 — prod serve command override (falls back to Project.prodCommand)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId])
  @@index([projectId])
}

//? K1 — an attached third-party SERVICE STACK: a SANITIZED docker-compose file the workspace runs alongside its
//? app containers (Postgres/Kafka/Redis/Elasticsearch/…). Namespaced per workspace (compose project
//? `ws-<id>-<name>`, a per-workspace network, a volume prefix) so two workspaces' stacks never collide. The
//? Conductor is the only writer; `composeSanitize` gates the compose before it is stored/run.
model ServiceStack {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @db.ObjectId
  name        String                              // stack name (part of the compose project name)
  compose     String                              // the SANITIZED compose yaml (host-escapes rejected, host-ports rewritten)
  services    String[]                            // the service names in the stack (from the sanitizer)
  status      String   @default("stopped")        // 'stopped' | 'running' | 'error'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

//? U1 — a "unfuck the UI" review request: uploaded screenshots + ticked problems (the UI_PROBLEMS taxonomy) +
//? free-text notes. U2 turns an accepted one into N redesign variants → a ticket with the chosen design + the
//? ticked problems as stage instructions. Conductor-only writer (B-23).
model UiReviewRequest {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @db.ObjectId
  page        String?                             // which page/flow (free label)
  screenshots String[]                            // /media/… urls (K1 upload)
  problems    String[]                            // taxonomy keys (server/ui/uiReview UI_PROBLEMS)
  notes       String?                             // free-text ("anything off-list")
  status      String   @default("open")           // 'open' | 'redesigned' | 'closed'
  createdById String?  @db.ObjectId
  createdAt   DateTime @default(now())

  @@index([workspaceId, status])
}

//? H1 — the admin/security AUDIT LOG. The audit found governance ops (role changes, secret read/writes, member
//? removal, ownership transfer, workspace deletion, invites) left ZERO trace — an admin couldn't answer "who did
//? what". This append-only log records every such op: WHO (actor userId), WHAT (action), on WHICH target, WHEN.
//? Conductor-only writer (the ops it records already run there).
model AuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @db.ObjectId
  actorId     String?  @db.ObjectId               // the user who performed it (null = system)
  action      String                              // e.g. 'change-role' | 'save-env' | 'remove-member' | 'transfer-ownership'
  target      String?                             // the affected entity (member id / env key / role key …)
  metadata    Json?                               // extra context (old→new role, etc.) — never the secret VALUE
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
}

//? Per-project forge connection (ADR 0036, item A2 — GitHubForge). Generalizes the
//? workspace GitLab fields (`Workspace.forgeType`/`gitlabUrl`/`gitlabTokenEnc`) to a
//? PER-PROJECT row so a workspace can mix GitLab + GitHub projects (multi-project, ADR
//? 0035). `mode` picks the provider. When a project has NO ForgeConnection, forge
//? resolution falls back to the workspace GitLab fields (zero migration for existing
//? single-forge workspaces — FORGE_ABSTRACTION §6 Q-FORGE-DATAMODEL). Deviates from the
//? doc's per-WORKSPACE `@@unique([workspaceId])` design — per-project is forced by A1;
//? the builtin-mode fields (builtinRepoRef/ciRunner) are omitted (a separate build target).
model ForgeConnection {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId   String   @db.ObjectId               // tenant (runInTenant row-isolation)
  projectId     String   @db.ObjectId
  mode          String                               // 'gitlab' | 'github'
  baseUrl       String?                              // forge API base (gitlab.com / api.github.com / self-hosted)
  repoPath      String?                              // "owner/repo" (supersedes Project.gitlabPath when set)
  tokenEnc      String?                              // ENCRYPTED PAT (B-07 generalized): GitLab PAT | GitHub PAT
  webhookSecret String?                              // HMAC secret for inbound webhook verification
  status        String   @default("disconnected")    // 'connected' | 'disconnected' | 'error'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([projectId])                              // one forge per project (single-forge rule, §4)
  @@index([workspaceId])
}

//? A persistent, long-running deployment of a project/service at a STABLE route (ADR 0037, item
//? B1). Unlike the 30-min ticket preview, an Environment outlives any ticket: `dev`/`staging`/`prod`
//? each run the pipeline-built image behind `<kind>-<service>.<workspace>.<domain>`. The Conductor
//? is the only writer (B-23); the leader provisions the container (multi-instance-safe). One
//? environment per (project, service, kind) — enforced in the deploy op (Mongo nullable-unique is
//? unreliable, so no @@unique). `serviceId` null = the project root (single-service repo).
model Environment {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId    String    @db.ObjectId
  projectId      String    @db.ObjectId
  serviceId      String?   @db.ObjectId            // null = project root (single-service)
  kind           String                             // 'dev' | 'staging' | 'prod'
  route          String                             // full host FQDN (<kind>-<service>.<ws>.<domain>)
  imageRef       String?                            // the deployed image tag (Service/Project.baseImageRef)
  containerName  String?                            // the running container name
  branch         String?                            // the deployed branch (target branch by default)
  status         String    @default("idle")         // 'idle'|'deploying'|'live'|'error'|'stopped'
  healthUrl      String?                            // in-container readiness URL (localhost:<port>)
  lastError      String?
  lastDeployedAt DateTime?
  deployedCommit String?                            // D3 — the git commit the current deploy is running (watcher compares against branch head)
  autoRedeploy   Boolean   @default(false)          // D3 — demo-host follows main: the watcher redeploys on a new target-branch commit
  pinnedCommit   String?                            // D3 — serve a FIXED commit instead of the latest branch head (a frozen demo); disables auto-redeploy
  subdomain      String?                            // D2 — a user-chosen subdomain on the base domain (validated/unique) instead of the derived <kind>-<slug>
  customDomain   String?                            // D3 — a user-owned domain (A/CNAME → this host) served with Caddy on-demand TLS (gated by the tls-ask endpoint)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([workspaceId])
  @@index([projectId, kind])
}

//? A downloadable build export (ADR 0038, item B2) — the user must be able to EXPORT a build (the
//? pipeline-built image as a `docker save` tarball, or the built dist bundle) to self-host elsewhere.
//? The Conductor produces it (B-23); it's served over a signed, TTL'd, token-gated download link
//? (`/downloads/build/<token>`), never a public path. `filePath` is the on-disk artifact under the
//? workspace data dir; the row tracks build status + expiry so stale artifacts can be pruned.
model BuildArtifact {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId   String    @db.ObjectId
  projectId     String    @db.ObjectId
  kind          String                              // 'image' (docker save tarball) | 'bundle' (dist)
  imageRef      String?                             // the source image tag (kind='image')
  filePath      String?                             // on-disk artifact path (kind + hash)
  downloadToken String                              // single-use-ish signed token for the download link
  sizeBytes     Int       @default(0)
  status        String    @default("building")      // 'building' | 'ready' | 'error'
  error         String?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  //? #64 — the D4 deploy-hook result for THIS export (fired=whether a hook URL was configured; ok/httpStatus
  //? = its response). Null until the export completes + the hook is attempted; surfaced on the artifact row.
  deployHookFired  Boolean?
  deployHookOk     Boolean?
  deployHookStatus Int?

  @@index([workspaceId])
  @@index([projectId])
  @@index([downloadToken])
}

// ============================================================================
// Built-in CI (ADR 0039, item C1) — un-defers BUILTIN_CI_PIPELINES §9.
//
// ⚠ NAME-CLASH: `Pipeline` here is a project's `.workspaces/ci.yml` CI definition —
// UNRELATED to `PipelineStage` (the Kanban board columns: refine/plan/code/test/review).
// Same word, different concept. A CI job DAG that gates merge + prod-promote.
// ============================================================================

//? A project's CI definition, parsed from `.workspaces/ci.yml` (one active per project).
model Pipeline {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @db.ObjectId
  projectId   String   @db.ObjectId
  specHash    String                              // content-hash of the parsed ci.yml (reuse/invalidate)
  stages      String[]                            // ordered stage names from the spec
  enabled     Boolean  @default(true)
  runnerKind  String   @default("builtin")        // 'builtin' (container jobs) | 'external' (delegated)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, projectId])
}

//? One CI execution at a frozen commit. `status` rolls up the jobs; it GATES merge/promote.
model PipelineRun {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId    String    @db.ObjectId
  pipelineId     String    @db.ObjectId
  projectId      String    @db.ObjectId            // denormalized for the project-level "latest green?" gate
  ticketId       String?   @db.ObjectId            // DEV-#### ticket this run gates (null = branch-only)
  mergeRequestId String?   @db.ObjectId            // links to MergeRequest for the MR check-list + merge gate
  commitHash     String                             // frozen baseline (DH5) — a stale-commit green must NOT gate-pass
  trigger        String                             // 'merge' | 'mr-update' | 'stage-complete' | 'manual'
  status         String    @default("running")      // 'running' | 'success' | 'failed' | 'canceled'
  maxSeverity    String?                            // ADR 0040 — highest security finding severity in the run (critical|high|moderate|low|none)
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  artifacts      Json?

  @@index([workspaceId, pipelineId, status])
  @@index([workspaceId, mergeRequestId])
  @@index([workspaceId, projectId, status])
}

//? One job within a run (a container exec for the builtin runner). `status` is a run-state projection;
//? the seq-ordered `TicketEvent(type:'ci')` is the surface-rendering truth (BUILTIN_CI §9 invariant).
model PipelineJob {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId   String    @db.ObjectId
  pipelineRunId String    @db.ObjectId
  name          String                              // 'lint' | 'unit' | 'build' (from ci.yml)
  stage         String
  jobType       String    @default("script")        // ADR 0040 — 'script' | 'dep-audit' | 'secret-scan' | 'sca'
  needs         String[]                            // DAG edges
  script        String[]                            // the commands (run in the job container)
  imageRef      String                              // resolved image tag (audit)
  status        String    @default("pending")       // 'pending'|'running'|'success'|'failed'|'skipped'|'canceled'
  severity      String?                             // ADR 0040 — highest finding severity for a scanner job
  findings      Json?                               // ADR 0040 — parsed scanner findings (bounded)
  allowFailure  Boolean   @default(false)
  containerId   String?
  exitCode      Int?
  logTail       String?                             // last chunk of stdout/err (bounded, for the UI)
  startedAt     DateTime?
  finishedAt    DateTime?

  @@index([workspaceId, pipelineRunId, status])
}

//? A user-app database connection (ADR 0043, item D1) — per project (optionally per service/env). The
//? connection string is ENCRYPTED at rest (B-07, `secretBox`), never client-visible. Drives the read-only
//? DB explorer + migration apply. `kind` picks the client (psql/mysql/mongosh — all in the base image).
model DbConnection {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @db.ObjectId
  projectId   String   @db.ObjectId
  serviceId   String?  @db.ObjectId
  envKind     String   @default("dev")           // 'dev' | 'staging' | 'prod' — which environment's DB
  name        String
  kind        String                              // 'postgres' | 'mysql' | 'mongo'
  urlEnc      String                              // ENCRYPTED connection string (B-07)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([projectId, envKind])
}

//? A user-app schema migration (ADR 0043, D1). Authored by the coding agent (schema-diff → SQL); applied
//? as a GATED control-op per environment (dev auto; prod = approval + a recorded rollback plan). `status`
//? tracks the apply lifecycle per env. Never applied client-side — the Conductor applies (B-23).
model Migration {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId  String    @db.ObjectId
  projectId    String    @db.ObjectId
  name         String
  sql          String                              // the forward migration SQL
  rollbackSql  String?                             // the rollback plan (prod apply requires it)
  envKind      String    @default("dev")           // the environment this apply targets
  status       String    @default("pending")       // 'pending' | 'applied' | 'failed'
  error        String?
  appliedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([workspaceId])
  @@index([projectId, status])
}

// ---- embedded per-stage config (composite types; mirrors PipelineStageCfg) ----

//? A base model choice (model/effort/max-turns) → maps to --model/--max-turns (B-38).
type StageModelChoice {
  model    String        // 'haiku' | 'sonnet' | 'opus' (provider-specific; Q-MP-CAPREG forward-pointer)
  effort   String        // 'low' | 'medium' | 'high' | 'xhigh' | 'max'
  maxTurns Int
}

//? One auto-escalation rule: "score >= minScore → this model/effort/max-turns".
type ModelRule {
  id       String
  minScore Int
  model    String
  effort   String
  maxTurns Int
}

//? Model selection: a base choice + optional auto-escalation by the self-assigned
//? complexity score. `contextBudgetTokens` = per-stage token budget → self-handoff
//? (04 §3, 06).
type StageModelCfg {
  autoEscalate        Boolean
  base                StageModelChoice
  rules               ModelRule[]
  contextBudgetTokens Int?
}

//? Network egress: allow-list (only these) or block-list (all except these),
//? built from category presets + explicit hosts. Maps to permissions.sandbox.network.
type StageNetworkCfg {
  enabled    Boolean
  mode       String        // 'whitelist' | 'blacklist'
  categories String[]
  domains    String[]
}

//? A whitelisted command pattern → a `.claude` permission rule (allow/ask/deny).
type StageCommandCfg {
  id       String
  pattern  String
  mode     String          // 'allow' | 'ask' | 'deny'
  title    String?
  desc     String?
  category String?
}

//? A stage selects a workspace-configured integration tool (by id) + a tier
//? (the tier → mongo:ro|rw graded client, B-O8).
type StageToolCfg {
  toolId String
  tier   String            // 'ro' | 'rw'
}

//? A per-stage status label (non-lifecycle; distinct from the AI-owned
//? TicketStatus enum). `kind` = 'base' | 'custom'.
type StageStatusCfg {
  key   String
  label String
  kind  String
}

//? An env var injected into a stage process.
type StageEnvVar {
  key   String
  value String
}

//? A container process: where it runs (cwd), its env, and the ordered commands.
//? Stack-agnostic (npm / dotnet / go / make / …).
type StageProcessCfg {
  id       String
  name     String
  cwd      String
  env      StageEnvVar[]
  commands String[]
}

//? One pipeline stage (meta) + its full editable config, flattened onto the model
//? (mirrors the prototype `PipelineStageCfg`). Belongs to a Project directly (no
//? separate `Pipeline` wrapper — decision #2). `id` is a FREE string (custom
//? stages allowed); `kind` is the typed StageKind role (04b §12). Field sweep
//? (04b §13): systemPrompt, roleKey, avgTokensPerTurn, contextBudgetTokens
//? (on modelCfg). V1_SCOPE §3.2: `userEditable` (edit-lock) + `gateForApproval`
//? (proceed-or-gate).
model PipelineStage {
  id                 String            @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId        String            @db.ObjectId
  projectId          String            @db.ObjectId
  key                String                                   // stable semantic slug ('unrefined'|'impl'|…) — the id Tickets reference + the board columns key on (the ObjectId _id can't be the slug: it must be unique per collection). The read-snapshot maps this → the frontend's `id`.
  kind               String                                   // StageKind: 'refine'|'plan'|'code'|'test'|'review'|'final' (04b §12)
  name               String
  order              Int
  aiEnabled          Boolean           @default(true)
  wipLimit           Int?                                     // column WIP warning threshold

  // --- prompt layering (D2/D17) ---
  roleKey            String            @default("code")       // 04 §3 (03 §3) — the AgentRole plugin binding
  systemPrompt       String            @default("")           // D2/D17 — layered base prompt
  customInstructions String            @default("")
  promptTemplate     String            @default("")           // carry-over template with {{chips}}
  definitionOfDone   String            @default("")           // optional per-stage "done when…"; empty ⇒ the AI judges completion itself

  // --- V1_SCOPE §3.2 per-stage flow toggles ---
  userEditable       Boolean           @default(true)         // "may the user edit while this stage is active" (edit-lock)
  gateForApproval    Boolean           @default(false)        // proceed-or-gate: gate for human approval before promoting

  // --- child config (embedded) ---
  skillKeys          String[]                                 // enabled InfoSource(skill) ids
  sourceIds          String[]                                 // loaded InfoSource(context-doc) ids
  commands           StageCommandCfg[]
  tools              StageToolCfg[]
  statuses           StageStatusCfg[]
  processes          StageProcessCfg[]
  visibleStageIds    String[]
  modelCfg           StageModelCfg
  network            StageNetworkCfg
  hooks              Json                                     // Record<hookKey, boolean> — which lifecycle hooks fire
  avgTokensPerTurn   Int?                                     // doc 05 (D4/D28) — rolling per-stage average feeding the estimate blend

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([workspaceId, projectId, key])
  @@index([workspaceId, projectId, order])
}

// ============================================================================
// Tickets / board (tenant-scoped)
// ============================================================================

//? A ticket = { stageId, status } (DH5 two-level). `status` is the AI-owned
//? TicketStatus lifecycle ('idle'|'needs-input'|'busy'|'done'|'paused'|'stuck',
//? Q-DATA-STATUS closed set). `stageId` is a free string → PipelineStage.id.
//? GitLab-derived caches (B-29, Q-DATA-ASSIGNMENT): creatorId/assigneeId/
//? mrUrl/issueUrl. Field sweep (04b §13): archived, lastActivityAt, canonical
//? mrUrl/issueUrl (prototype `mr?`/`issue?` shorthands). `commitHash` frozen at
//? worktree creation (DH5). Prototype mirror: `Ticket` (types.ts:49).
model Ticket {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId    String   @db.ObjectId
  projectId      String   @db.ObjectId
  key            String                          // display id, e.g. "DEV-1240" (GitLab issue-derived)
  number         Int                             // the GitLab issue number
  title          String
  description    String?
  stageId        String                          // current pipeline column → PipelineStage.id (free string)
  status         String                          // TicketStatus: idle|needs-input|busy|done|paused|stuck
  labels         String[]                        // GitLab-native, cached
  creatorId      String?  @db.ObjectId           // GitLab-derived cache (B-29)
  assigneeId     String?  @db.ObjectId           // GitLab-derived cache (B-29)
  branch         String?                         // the DEV-#### branch
  mrUrl          String?                         // GitLab-derived cache — the MR url (canonical, was prototype `mr?`)
  issueUrl       String?                         // GitLab-derived cache — the issue url (canonical, was prototype `issue?`)
  commitHash     String?                         // frozen worktree commit the ticket's context is pinned to (DH5)
  sprintId       String?  @db.ObjectId
  carryOver      String?                         // the HUMAN one-liner (derived from the latest CarryOver envelope summary, 04b §14)
  needsInput     String?                         // denormalized banner = first open question (04 §2)
  needsInputQuestions Json?                       // W1 — the FULL open-question set [{q,a}] (multi-question; banner = first unanswered). Null = single/legacy.
  advisoryQuestions Json?                          // W2 — NON-blocking questions the agent PROCEEDED past with an assumption [{q,assumption,a,resolved}]. A divergent answer schedules a revision turn; the ticket never parks on these.
  remindedAt     DateTime?                        // A5 — last time the watchdog re-pinged the assignee about this open question (null = never / cleared on answer)
  priority       String   @default("normal")     // low|normal|high|urgent — `urgent` = hotfix/security tier that force-passes the capacity cap (#12)
  archived       Boolean  @default(false)        // doc 13 bulk Archive — soft, never deletes
  lastActivityAt DateTime?                        // denormalized from the latest TicketEvent — default backlog sort key
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([workspaceId, key])
  @@index([workspaceId, projectId, stageId])
  @@index([workspaceId, sprintId])
  @@index([workspaceId, archived, lastActivityAt])
}

//? A ticket↔ticket relation. `ai` = AI-suggested; `reason` = why (shown on hover).
//? Prototype mirror: `TicketLink` (types.ts:88).
model TicketLink {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId    String   @db.ObjectId
  ticketId       String   @db.ObjectId
  targetTicketId String   @db.ObjectId          // the related ticket
  rel            String                          // 'relates to' | 'blocks' | 'duplicates'
  ai             Boolean  @default(false)        // AI-suggested
  reason         String?                         // why the AI proposed the link
  createdAt      DateTime @default(now())

  @@index([workspaceId, ticketId])
  @@index([workspaceId, targetTicketId])         // blocks-gate: openBlockersFor queries the REVERSE direction
}

//? An external / info reference attached to a ticket (04 §1, cascade list 04b
//? §11d). Minimal V1 shape — the docs name the model but give no build-grade body;
//? this is an inferred shape (flagged in the ADR). Covers e.g. an attached
//? InfoSource or an external url a stage produced.
model TicketReference {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @db.ObjectId
  ticketId    String   @db.ObjectId
  kind        String                          // 'info-source' | 'url' | ... (inferred)
  sourceId    String?  @db.ObjectId           // → InfoSource.id when kind='info-source'
  url         String?
  label       String?
  createdAt   DateTime @default(now())

  @@index([workspaceId, ticketId])
}

//? A sprint with a duration (B-30). Real DateTime columns replace the prototype's
//? display strings (04b §13: startAt/endAt, workspace tz). Prototype mirror:
//? `Sprint` (types.ts:109).
model Sprint {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String    @db.ObjectId
  projectId   String    @db.ObjectId            // ADR 0035 — sprints belong to a project's board (backfilled to project #1)
  name        String
  startAt     DateTime?                         // workspace tz (D55) — replaces prototype display-string `start`
  endAt       DateTime?                         // replaces prototype display-string `end`
  active      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([workspaceId, active])
  @@index([workspaceId, projectId, active])
}

// ============================================================================
// Event log (tenant-scoped, APPEND-ONLY)
// ============================================================================

//? The single ordered, immutable, per-ticket fact stream (04b §6). Append-only:
//? never updated/deleted via the app. `seq` is MONOTONIC per ticket (Redis INCR
//? ws:{workspaceId}:ticket:{ticketId}:evseq) and is the client merge/dedupe key
//? (NOT createdAt — clock skew). The ONLY writer is the Conductor (B-23). Prototype
//? mirror: `ActivityEvent` (types.ts:137).
model TicketEvent {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @db.ObjectId
  ticketId    String   @db.ObjectId
  seq         Int                              // MONOTONIC per ticket (Redis INCR); the merge/dedupe key
  type        String                           // 'command'|'file-change'|'ai-message'|'status-change'|'mr'|'comment' (+ growth)
  actor       String                           // member userId | 'ai' | 'conductor' | 'mr' | 'gitlab'
  sessionKey  String?                          // worker:ticket:stage | assistant:user | conductor — provenance of an AI-sourced event
  stageId     String?                          // the StageKind key the event occurred in, if stage-scoped
  text        String                           // rendered one-liner for the feed
  metadata    Json?                            // { commitHash?, changedFiles?[], mrUrl?, diffRef?, voiceTranscript?, ... }
  createdAt   DateTime @default(now())

  @@index([workspaceId, ticketId, seq])        // the ordered-read index (subscribe-first → snapshot)
  @@index([workspaceId, createdAt])             // the workspace-wide feed (bounded-window)
}

// ============================================================================
// Runtime (tenant-scoped)
// ============================================================================

//? The ONE canonical runtime row (04b §7 — merges three prior conflicting defs).
//? The orchestrator's durable runtime fact: socket sessions are ephemeral; the
//? SessionManager rehydrates PTYs from these rows on boot (resumeAll, 01 §4).
//? `status` = ready|busy|paused|stopped (canonical 4-set, distinct from
//? Ticket.status + StageStatusCfg). No LLM verb mutates this row — driven by
//? [control-API] Conductor actions + Stop/SessionStart hooks.
model AgentSession {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId      String   @db.ObjectId
  ticketId         String?  @db.ObjectId          // null for assistant sessions not bound to a ticket
  stageId          String?                         // the StageKind key; worker sessions only

  // --- identity / role ---
  kind             String                          // 'assistant' | 'worker' (+ optional future 'reasoner')
  userId           String?  @db.ObjectId           // ASSISTANT sessions only: whose chat → drives that user's RBAC
  sessionKey       String                          // assistant:{userId} | worker:{ticketId}:{stageId} | reasoner:{...}

  // --- engine / lifecycle (Claude-CLI-PTY) ---
  claudeSessionId  String?                         // for `claude --resume`; RE-CAPTURED if /clear rotates it
  model            String?                         // resolved model literal at spawn (haiku|sonnet|opus)
  cliVersion       String?                         // EXACT pinned Claude CLI version that ran this session (audit)
  baseImageRef     String?                         // resolved L2 image tag (content-hash) this session ran in

  // --- container binding (crash-recovery) ---
  containerId      String?                         // L3 per-ticket container id; null for host-side reasoning roles
  worktreePath     String?                         // the in-container clone path
  ptyAgentUrl      String?                         // 127.0.0.1:<port> the in-container pty-agent publishes

  // --- status (the SINGLE runtime state machine) ---
  status           String                          // ready | busy | paused | stopped

  // --- budget / estimate feed (advisory) ---
  tokenEstimate    Int      @default(0)            // running estimate for the self-handoff / budget trigger; ADVISORY
  durationEstimate Int?                             // seconds; cold-start self-estimate (D4); nullable until a planning stage runs

  // --- structured-channel security ---
  channelTokenId   String?                         // id (NOT secret) of the per-session structured-channel token; RE-MINTED per spawn/resume
  hookTokenId      String?                         // id of the SEPARATE per-session WS_HOOK_TOKEN

  startedAt        DateTime @default(now())
  lastHeartbeatAt  DateTime?

  @@index([workspaceId, ticketId])
  @@index([workspaceId, kind, userId])            // an Assistant lookup by (kind, user)
  @@index([workspaceId, status])                  // CapacityManager admission scan
  @@unique([workspaceId, sessionKey])             // one live row per logical session
}

// ============================================================================
// Carry-forward + questions (tenant-scoped)
// ============================================================================

//? The structured stage→stage envelope (04 §2, B-O2). APPEND-ONLY (04b §11a).
//? `Ticket.carryOver` (string) stays the human one-liner; this stores the machine
//? envelope. Emitted as a `ws-carryover` fenced block, parsed Conductor-side (04b §14).
model CarryOver {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @db.ObjectId
  ticketId    String   @db.ObjectId
  fromStageId String
  toStageId   String
  sessionId   String   @db.ObjectId
  envelope    Json                             // { summary, changedFiles[], openQuestions[], commitHash }
  createdAt   DateTime @default(now())

  @@index([workspaceId, ticketId, createdAt])
}

//? Token-optimization self-handoff (04 §2, 06). APPEND-ONLY (04b §11a). Written
//? when a long session crosses its context budget: the AI emits `emit_handoff`,
//? the orchestrator stores it, /clears the session, and reloads `body` as the
//? fresh opening context. Superset of the CarryOver envelope (04b §14).
model Handoff {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @db.ObjectId
  sessionKey  String                          // assistant:… | worker:ticket:stage (| reasoner:… future)
  ticketId    String?  @db.ObjectId
  stageId     String?
  body        Json                             // { summary, decisions[], state, next[], gotchas[], carried? }
  reason      String                           // 'budget' | 'manual'
  createdAt   DateTime @default(now())

  @@index([workspaceId, sessionKey, createdAt])
}

//? One question inside a QuestionSet (embedded composite).
type Question {
  id      String
  text    String
  kind    String         // 'free' | 'choice' | 'approve'
  choices String[]
  answer  String?
}

//? The phone-from-the-beach loop (04 §2, 02 §5). `Ticket.needsInput` (denormalized
//? banner) = the first open question. A correction is a NEW superseding set (D49).
model QuestionSet {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String     @db.ObjectId
  ticketId    String     @db.ObjectId
  stageId     String
  sessionId   String     @db.ObjectId
  status      String                          // 'open' | 'answered' | 'superseded'
  questions   Question[]
  createdAt   DateTime   @default(now())
  answeredAt  DateTime?

  @@index([workspaceId, ticketId, status])
}

// ============================================================================
// Automation + workspace-AI (tenant-scoped)
// ============================================================================

//? Automation (04 §2, 03 §1). Accepting an `automation` suggestion materializes
//? one of these through [control-API] → the Conductor (never the LLM, B-23).
model WorkspaceTrigger {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId      String   @db.ObjectId
  enabled          Boolean  @default(true)
  name             String
  on               String                          // stage.on_enter|on_complete|on_signal|on_approval | ticket.created|merged | suggestion.accepted | cron
  match            Json                             // { stageIds?[], statusKeys?[], projectIds?[] }
  cron             String?                          // iff on=='cron'
  action           String                           // start-stage|invoke-workspace-ai|run-command|emit-signal|notify
  params           Json                             // { targetStageId?, template?, command?, notifyType? }
  requiresApproval Boolean  @default(false)
  dedupeKey        String?
  debounceMs       Int?
  lastFiredAt      DateTime?
  createdAt        DateTime @default(now())

  @@index([workspaceId, on, enabled])
}

//? Durable signal transport (B-O6). APPEND-ONLY (04b §11a). The Conductor /
//? Workspace-AI consumes serially; `seq` (monotonic) + `processedAt` give the
//? serial-consumption ordering (04 §3). Survives restart; part of the audit.
model WorkspaceSignal {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String    @db.ObjectId
  seq         Int                               // MONOTONIC (serial consumption ordering)
  kind        String                             // the signal type
  payload     Json
  processedAt DateTime?                           // null until the consumer serially processes it
  createdAt   DateTime  @default(now())

  @@index([workspaceId, seq])
  @@index([workspaceId, processedAt])
}

//? Studio module — a product/marketing BRIEF the AI designer/marketer roles work from.
model StudioBrief {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @db.ObjectId
  projectId   String?  @db.ObjectId                 // optional link to the project it markets
  name        String                                 // the brief's own label (e.g. "Launch v1")
  productName String                                 // what is being marketed
  audience    String                                 // target audience
  tone        String                                 // brand voice / tone (e.g. "bold, playful")
  goals       String                                 // what the marketing should achieve
  notes       String?                                // freeform extra context
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId, createdAt])
}

//? Studio module — the workspace's CENTRAL BRAND LIBRARY (ADR 0013 G-MKT-2): one source of brand
//? truth (palette, typography, voice, taglines, logo ideas) that every Designer/Marketing generation
//? seeds from, so all artifacts stay on-brand. One per workspace (upserted).
model StudioBrandLibrary {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @unique @db.ObjectId
  name        String   @default("Brand")
  palette     Json                                   // [{ name, hex }]
  typography  Json                                   // { heading, body }
  voice       String   @default("")
  taglines    String[]
  logoIdeas   String[]
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

//? X3 — a scoped, revocable Personal Access Token for the public API. Only the SHA-256 hash is stored (the raw
//? token is shown once at issue). Scoped per workspace + per capability; RBAC + single-writer still apply when
//? a PAT drives a control-op.
model PersonalAccessToken {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  workspaceId String    @db.ObjectId
  name        String
  tokenHash   String    @unique                     // sha256(raw) hex — the raw is never stored
  tokenPrefix String                                 // first chars of the raw, for display (e.g. 'wsk_ab12')
  scopes      String[]                               // e.g. ['tickets:write', 'content:read']
  revoked     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  @@index([userId])
  @@index([workspaceId])
}

//? O5 — a reusable OUTPUT SPEC: a named render format (aspect + optional watermark position) a user defines
//? once and applies across pieces, so a repeatable video format doesn't have to be re-picked each time.
model OutputTemplate {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId       String   @db.ObjectId
  name              String
  format            String   @default("16:9")           // '16:9' | '9:16' | '1:1' (render.ts RenderFormat)
  watermarkPosition String   @default("")               // '' | 'br' | 'bl' | 'tr' | 'tl'
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([workspaceId])
}

//? E5 — a user-defined, re-runnable AI task: a named prompt-template (with {{variables}}) that runs through
//? the provider abstraction (feature 'custom-generate') and stays propose/generate — it NEVER writes
//? authoritative state, only produces `lastOutput` the user reads. Schedulable via the trigger engine.
model CustomAiTask {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId    String   @db.ObjectId
  name           String
  promptTemplate String                                 // may contain {{variable}} placeholders
  lastOutput     String?                                // the most recent run's output (read-only display)
  lastRunAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([workspaceId])
}

//? Studio module — a generated ARTIFACT (a landing page, copy set, brand kit, or strategy)
//? produced by an AI role from a brief. `content` is the structured, kind-specific payload the
//? Studio UI renders + live-previews.
model StudioArtifact {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @db.ObjectId
  briefId     String   @db.ObjectId
  kind        String                                 // 'landing' | 'copy' | 'brand' | 'strategy'
  role        String                                 // 'designer' | 'marketer'
  title       String
  content     Json                                   // kind-specific: {html} | {items[]} | brand tokens | {markdown}
  providerId  String?                                // which AI backend produced it
  status      String   @default("ready")             // 'generating' | 'ready' | 'error'
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId, briefId, createdAt])
}

//? Designer module (ADR 0034) — a persisted design-library entry: a theme, style, or animation.
//? `content` is the kind-specific token/spec payload the Designer UI renders. `active` marks the ONE
//? theme + the ONE style that are the workspace's current truth → synthesized into the injected
//? 'design-system' context-doc the coding agent builds on.
model DesignArtifact {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @db.ObjectId
  kind        String                              // 'theme' | 'style' | 'animation'
  name        String
  description String?
  content     Json                                // kind-specific: theme token-set | style spec | anim spec
  source      String   @default("manual")         // 'seed' | 'manual' | 'ai'
  active      Boolean  @default(false)            // the active theme/style for the workspace (one per kind)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId, kind, active])
}

//? Interviewer module (ADR 0034) — a persisted, CATEGORISED improvement finding produced by the
//? interviewer role/chat (replaces the notification-only output). A human can turn one into a ticket
//? (B-23), recorded in `ticketId`.
model InterviewFinding {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @db.ObjectId
  area        String                              // 'reliability'|'dx'|'ux'|'performance'|'security'|'product'|'other'
  severity    String   @default("normal")         // 'low' | 'normal' | 'high'
  title       String
  summary     String                              // one-line why-it-matters
  detail      String?                             // optional longer body
  status      String   @default("open")           // 'open' | 'accepted' | 'dismissed'
  ticketId    String?  @db.ObjectId               // set when converted into a ticket
  createdAt   DateTime @default(now())

  @@index([workspaceId, status, area])
}

//? ADR 0034 — a live reference linking a ticket to a design/Studio artifact. At stage-spawn the
//? Conductor reads a ticket's links and injects the current artifact as extra context.
model TicketArtifactLink {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId  String   @db.ObjectId
  ticketId     String   @db.ObjectId
  artifactId   String   @db.ObjectId              // → DesignArtifact.id | StudioArtifact.id
  artifactKind String                             // 'design' | 'studio'
  label        String?
  linkedBy     String?  @db.ObjectId              // userId
  createdAt    DateTime @default(now())

  @@index([workspaceId, ticketId])
}

//? The Assistant's propose-only output (B-23). Extended `type` (04b §8 + ADR 0034).
//? `patch` carries the appliable config/automation/design patch — applied ONLY when the
//? user accepts → Conductor executes. Prototype mirror: `AiSuggestion` (types.ts:101).
model WorkspaceSuggestion {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @db.ObjectId
  type        String                              // 'link-tickets'|'create-epic'|'config-review'|'maintenance'|'automation'|'design'|'interview-answer'
  title       String
  body        String
  ticketIds   String[] @db.ObjectId               // tickets the suggestion concerns
  patch       Json?                               // appliable config patch { path, before, after } (config-review/automation only)
  status      String   @default("open")           // 'open' | 'accepted' | 'dismissed'
  createdAt   DateTime @default(now())

  @@index([workspaceId, status, createdAt])
}

//? A note the Workspace-AI may write (B-23 allows propose + notes, no writes).
//? Minimal V1 shape (04 §1 lists WorkspaceNote; no build-grade body given).
model WorkspaceNote {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @db.ObjectId
  ticketId    String?  @db.ObjectId
  authorKind  String                              // 'assistant' | 'user'
  authorId    String?  @db.ObjectId               // User.id when authorKind='user'
  body        String
  createdAt   DateTime @default(now())

  @@index([workspaceId, ticketId, createdAt])
}

//? #111 — persisted Workspace-AI chat turns, scoped PER-USER per-workspace (the Assistant
//? chat is per-user, mirroring `WorkspaceSnapshot.notifications`). Only `role` + `text` are
//? persisted: a turn's `proposal`/`plan` are TRANSIENT offers (accept dispatches a live op) —
//? resurrecting a stale Accept button on reload would be wrong, so history rehydrates as plain
//? text only. Bounded read window in the snapshot (newest 100, chronological).
model WorkspaceChatMessage {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @db.ObjectId
  userId      String   @db.ObjectId               // whose chat (per-user Assistant scope)
  role        String                              // 'user' | 'ai'
  text        String
  createdAt   DateTime @default(now())

  @@index([workspaceId, userId, createdAt])
}

// ============================================================================
// Spend / budget (tenant-scoped)
// ============================================================================

//? The append-grade per-turn cost fact (04b §9). APPEND-ONLY (04b §11a). Tokens
//? are ADVISORY in PTY mode (hook payload if present, else char-count estimate).
//? Prototype mirror: `UsageRow` (types.ts:225).
model SpendRecord {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId  String   @db.ObjectId
  userId       String?  @db.ObjectId               // H2 — the user this turn's cost is attributed to (ticket assignee/creator)
  ticketId     String?  @db.ObjectId
  stageId      String?                             // StageKind key
  sessionKey   String                              // the AgentSession this turn belongs to
  tokensIn     Int      @default(0)                // ADVISORY
  tokensOut    Int      @default(0)
  model        String                              // resolved model literal (pricing key)
  costEstimate Float    @default(0)                // tokens × editable per-model price (D31); 0 when pricing zeroed-out
  providerId   String?                             // AiProviderId that ran this turn (per-AI usage breakdown)
  feature      String?                             // AiFeature/role key (per-AI usage breakdown)
  createdAt    DateTime @default(now())

  @@index([workspaceId, ticketId, createdAt])      // per-ticket cost chip
  @@index([workspaceId, stageId, createdAt])       // rolling per-stage average → the D4 estimate blend
  @@index([workspaceId, providerId, createdAt])    // per-AI usage breakdown
}

//? Multi-row / multi-cap budget (04b §9, D81/D82). MULTIPLE rows per workspace.
//? `enforcement` = 'pauseNew' (block new sessions) | 'pauseAll' (pause all now) —
//? a Conductor action, advisory-then-pause. `periodWindow` = 'calendar-month'
//? (default, workspace tz) or a rolling window { rolling: '5h' }. Prototype mirror:
//? `WorkspaceBudget` (types.ts:129, single-row → multi-cap here).
model WorkspaceBudget {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId   String   @db.ObjectId               // MULTIPLE rows per workspace (multi-cap, D81)
  label         String                              // the cap's display name in the caps-list editor
  cap           Float                               // the spend/quota ceiling, in the periodWindow's unit
  alertPct      Int      @default(80)               // notify threshold (% of cap)
  enforcement   String                              // 'pauseNew' | 'pauseAll'
  periodWindow  Json     @default("\"calendar-month\"") // 'calendar-month' (default) | { rolling: '5h' | '30d' | ... } (D82)
  spent         Float    @default(0)                // running spend in the current window (recomputed on reset)
  windowStartAt DateTime @default(now())            // start of the current period window (rolls forward on reset)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([workspaceId, enabled])
}

// ============================================================================
// Notifications (tenant-scoped; PushSubscription is framework-global above)
// ============================================================================

//? The server-owned notification source (04b §10). Full `body` stored server-side,
//? shown IN-APP behind auth; the web-push payload is REDACTED by default (D80
//? reversed). Fan-out is one row per recipient. Prototype mirror: `NotificationItem`
//? (types.ts:119, a read-projection).
model Notification {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @db.ObjectId
  userId      String   @db.ObjectId               // recipient (per-user)
  type        String                              // 'needs-input' | 'merge' | 'ai-suggestion' | 'container-failure'
  title       String
  body        String                              // full body — stored server-side, shown in-app behind auth
  ticketId    String?  @db.ObjectId               // deep-link target
  deepLink    Json?                               // { view, ticketId?, tab?, terminalId? } — the D65 navigate payload
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([workspaceId, userId, read, createdAt])  // the bell + unread badge + grouped center
}

// ============================================================================
// Info layer (tenant-scoped)
// ============================================================================

//? Context docs (loaded as files) + skills/MCP (queried on demand) — 04 §1,
//? B-14/B-15. `mode` = 'context-doc' | 'skill'. Prototype mirrors: `InfoDoc`
//? (types.ts:173) + `SkillEntry` (types.ts:185), unified here.
model InfoSource {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId   String    @db.ObjectId
  projectId     String?   @db.ObjectId
  mode          String                            // 'context-doc' | 'skill'
  name          String
  source        String?                            // context-doc: 'generated'|'git'|'uploaded'
  summary       String?
  note          String?                            // "frozen @ abc123" | "spec"
  content       String?                            // context-doc body (read-only preview)
  usedByStages  String[]                           // stage ids/names that load this source
  commitHash    String?                            // frozen-per-commit store stamp (B-25)
  // --- skill-specific ---
  kind          String?                            // skill: 'frozen' | 'live'
  model         String?                            // skill: embedding/model label
  enabled       Boolean   @default(true)           // skill on/off (SkillEntry.on)
  lastIndexedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId, mode])
}

//? The append-only, commit-stamped RAG store (B-25, server-only). APPEND-ONLY
//? (04b §11a). Embeddings stored as Json (the Atlas $vectorSearch payload, or a
//? Float[] app-side-cosine fallback, B-24/G10). Dedupe on commitHash+filePath+
//? chunkId (B-O3). Minimal V1 shape (no build-grade body in the docs).
model RagEntry {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @db.ObjectId
  projectId   String?  @db.ObjectId
  sourceId    String?  @db.ObjectId               // → InfoSource.id
  commitHash  String                              // the frozen commit this chunk is stamped to
  filePath    String
  chunkId     String
  content     String
  embedding   Json?                               // the vector (Atlas $vectorSearch) or Float[] fallback
  createdAt   DateTime @default(now())

  @@index([workspaceId, commitHash, filePath])
}

// ============================================================================
// Workspace-level integrations (tenant-scoped)
// ============================================================================

//? A field on an integration tool, mapped to an env var. Embedded composite.
type IntegrationField {
  id          String
  label       String
  placeholder String?
  envVarId    String?        // → EnvVar.id
}

//? An MCP-server exposure of an integration tool. Embedded composite.
type McpCfg {
  enabled Boolean
  command String
}

//? A workspace env var (holds the real secret/config; integration tools point at
//? it). Prototype mirror: `EnvVar` (types.ts:272). Secrets stored encrypted
//? server-side (the `value` here is the app-owned encrypted payload when secret).
model EnvVar {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @db.ObjectId
  key         String
  value       String                              // encrypted when `secret`
  secret      Boolean  @default(false)
  serviceName String?                             // K3 — set when this EnvVar was published by a service preset (removed on that stack's teardown)
  createdAt   DateTime @default(now())

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

//? A configured integration tool (maps config fields → env vars + optionally an
//? MCP server). The pipeline SELECTS which tools a stage may use (StageToolCfg).
//? Prototype mirror: `IntegrationTool` (types.ts:274).
model IntegrationTool {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String             @db.ObjectId
  name        String
  type        String                              // INTEGRATION_TYPES key, or custom
  fields      IntegrationField[]
  mcp         McpCfg
  createdAt   DateTime           @default(now())

  @@index([workspaceId])
}

// ============================================================================
// Built-in merge-request review (BUILTIN_MR_REVIEW, tenant-scoped)
// ============================================================================

//? A merge request for a ticket's DEV-branch → target branch. The built-in review surface:
//? line-anchored threads + approvals (stale on new head) + a merge action. Forge-backed when a
//? GitLab MR exists (externalUrl), else the built-in record is the source of truth.
model MergeRequest {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId   String    @db.ObjectId
  projectId     String    @db.ObjectId
  ticketId      String    @db.ObjectId
  number        Int                                // per-workspace MR number
  title         String
  description   String?
  sourceBranch  String
  targetBranch  String
  status        String    @default("open")         // 'open' | 'merged' | 'closed' | 'conflict'
  headSha       String?                            // latest source-branch commit; approvals stale when it changes
  mergedSha     String?                            // the merge commit on the target (for a git-revert rollback, #9)
  mergeStrategy String    @default("merge")         // 'merge' | 'squash' | 'ff'
  externalUrl   String?                            // GitLab MR url when forge-backed
  authorId      String?   @db.ObjectId
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  mergedAt      DateTime?

  @@unique([workspaceId, number])
  @@index([workspaceId, ticketId])
  @@index([workspaceId, status])
}

//? A review thread on an MR: line-anchored (filePath+line) or MR-level (filePath null). Resolvable.
model ReviewThread {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId    String   @db.ObjectId
  mergeRequestId String   @db.ObjectId
  filePath       String?                           // null = general (MR-level) thread
  line           Int?                              // anchor line
  side           String   @default("new")          // 'old' | 'new'
  resolved       Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([workspaceId, mergeRequestId])
}

//? A comment within a review thread. Author is a member or the AI reviewer.
model ReviewComment {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId    String   @db.ObjectId
  threadId       String   @db.ObjectId
  mergeRequestId String   @db.ObjectId
  authorId       String?  @db.ObjectId
  authorKind     String   @default("user")         // 'user' | 'ai'
  body           String
  createdAt      DateTime @default(now())

  @@index([workspaceId, threadId])
  @@index([workspaceId, mergeRequestId])
}

//? An approval on an MR by a member. Invalidated (stale) when the MR head advances.
model Approval {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId    String   @db.ObjectId
  mergeRequestId String   @db.ObjectId
  userId         String   @db.ObjectId
  headSha        String?                           // the head the approval was granted at
  stale          Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([workspaceId, mergeRequestId, userId])
  @@index([workspaceId, mergeRequestId])
}

// ============================================================================
// Content platform (ADR 0049 — the `content` projectType lane). Tenant-scoped by
// explicit `workspaceId` filtering (the Conductor uses raw prisma), matching the
// other feature models (Service/ForgeConnection/Studio*). Media cost is in CENTS
// (metered €), distinct from the coding-agent token accounting (invariant #9).
// ============================================================================

//? A distribution channel (e.g. a YouTube/TikTok account) — the brand/style home a
//? content project publishes to. `platform` picks the posting adapter. `defaultStyleId`
//? seeds the channel's house style for new pieces.
model Channel {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId    String   @db.ObjectId
  projectId      String   @db.ObjectId
  name           String
  platform       String   @default("none")          // 'youtube' | 'tiktok' | 'instagram' | 'linkedin' | 'none'
  handle         String?                             // @handle on the platform
  description    String?
  brandVoice     String?                             // one-line house voice (seeds gen)
  defaultStyleId String?  @db.ObjectId               // → StylePreset.id (house style)
  aiDisclosureDefault Boolean @default(false)        // prefills the publish composer's synthetic-media checkbox (EU AI Act / platform policy); autopilot follows this
  defaultAccountId String?                            // which connected publish account this channel posts with (null = the platform default connection)
  autopilot      Boolean  @default(false)             // per-channel opt-in: idea→render→publish WITHOUT per-step approval (the consent is this switch — ADR)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([workspaceId, projectId])
}

//? A single content PIECE flowing through the content-pipeline (the content-lane analog
//? of a Ticket). `stageId`/`status` mirror Ticket so the generic stage-runner (F1.1) can
//? drive it. `format` picks the pipeline shape; `styleId` the default style.
model ContentProject {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @db.ObjectId
  projectId   String   @db.ObjectId
  channelId   String?  @db.ObjectId
  title       String
  brief       String?                               // the human brief / prompt
  publishVariants Json?                             // O2 — per-platform post overrides: { [platform]: { caption?, hashtags?, privacy? } }
  format      String   @default("faceless")         // 'faceless' | 'short' | 'explainer' | 'ad' | 'avatar' | 'image'
  aspectRatio String   @default("16:9")             // F1 — render aspect: '16:9' | '9:16' (shorts/reels) | '1:1'; threaded to assemble/render
  captionMode String   @default("sidecar")          // F2 — captions delivery: 'sidecar' (downloadable .srt/.vtt only) | 'burn' (hard-subtitled into the mp4) | 'soft' (mov_text track)
  ctaText     String?                                // H1 (ads) — a CTA / end-card line overlaid on the last seconds of the rendered ad (null = no overlay)
  stageId     String   @default("idea")             // content pipeline column
  status      String   @default("idle")             // idle|busy|needs-input|done|paused|stuck
  styleId     String?  @db.ObjectId                 // → StylePreset.id (default style for this piece)
  styleKey    String?                               // the piece's remembered style KEY (video-gen) — reused by the timeline decompose when no style is passed
  needsInput  String?                               // denormalized open question (answer-queue)
  voiceVolume Float    @default(1)                   // V5 audio-track — linear gain for the voiceover in the mix
  musicVolume Float    @default(0.25)                // V5 audio-track — ducked linear gain for the background music
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId, projectId, stageId])
  @@index([workspaceId, archived])
}

//? A produced media asset attached to a content piece (an image, clip, voiceover, render,
//? 3d mesh, …). `url`/`storageRef` point at the output; in stub/dummy mode these are
//? valid-shaped fakes. `metadata` is kind-specific.
model ContentAsset {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId      String   @db.ObjectId
  contentProjectId String   @db.ObjectId
  kind             String                            // 'image'|'video'|'voice'|'music'|'sfx'|'avatar'|'model-3d'|'render'|'script'
  url              String?
  storageRef       String?
  metadata         Json?
  mediaJobId       String?  @db.ObjectId
  parentId         String?  @db.ObjectId             // I2 — the asset this was regenerated/varied FROM (version lineage)
  status           String   @default("ready")        // 'pending' | 'ready' | 'error'
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([workspaceId, contentProjectId])
}

//? The narration script for a content piece (F1.2). `body` is the full text; `Beat`s split it.
model Script {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId      String   @db.ObjectId
  contentProjectId String   @db.ObjectId
  title            String?
  body             String
  styleId          String?  @db.ObjectId
  providerId       String?
  status           String   @default("ready")        // 'generating' | 'ready' | 'error'
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([workspaceId, contentProjectId])
}

//? One storyboard beat of a script (a sentence/shot). `visualPrompt` drives the per-beat
//? image/clip; `imageAssetId` links the produced visual; `durationMs` times the montage.
model Beat {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId      String   @db.ObjectId
  scriptId         String   @db.ObjectId
  contentProjectId String   @db.ObjectId
  order            Int
  text             String
  visualPrompt     String?
  imageAssetId     String?  @db.ObjectId
  durationMs       Int?
  createdAt        DateTime @default(now())

  @@index([workspaceId, scriptId, order])
}

//? V1 (IDEA_TO_OUTCOME) — an ordered VIDEO SCENE: a real clip (or a still shown ken-burns) that the multi-clip
//? render (V2) stitches, and the timeline editor (V5) manipulates. A long video = several scenes that flow into
//? each other (V3 decompose); a range-refine (V4) regenerates one scene as a new version (parentId lineage).
//? Distinct from Beat (a slideshow still bound to a script) — a Scene is a timeline segment for real video.
model VideoScene {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId      String   @db.ObjectId
  contentProjectId String   @db.ObjectId
  order            Int
  videoAssetId     String?                 // a real video clip ref (asset id), when present — plain string so a
  imageAssetId     String?                 // user-editable timeline never hard-fails on a non-ObjectId ref
  startTrimMs      Int      @default(0)    // trim in-point within the source clip
  endTrimMs        Int?                    // trim out-point (null = to the clip end)
  durationMs       Int      @default(5000) // effective on-timeline duration
  transitionIn     String   @default("cut") // 'cut' | 'fade' | 'xfade'
  prompt           String?                 // the scene's generation prompt (V3 decompose / V4 refine)
  parentId         String?  @db.ObjectId   // I2-lineage — a refined version of a prior scene
  createdAt        DateTime @default(now())

  @@index([workspaceId, contentProjectId, order])
}

//? A queued/async generation job to a media provider (F0.3). In stub/dummy mode it resolves
//? to a valid-shaped fake asset + a declared `costCents` (so the €-budget guard is testable).
model MediaJob {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId      String   @db.ObjectId
  contentProjectId String?  @db.ObjectId
  feature          String                            // AiFeature: image-gen|video-gen|tts|music|sfx|avatar|model-3d|reference-image|reference-video-analysis
  providerId       String                            // resolved provider (fal|elevenlabs|gemini-media|…)
  styleId          String?  @db.ObjectId
  input            Json                              // { prompt?, referenceUrl?, extraInstructions?, … }
  params           Json?
  status           String   @default("queued")       // 'queued' | 'running' | 'done' | 'error'
  queuePosition    Int?                              // provider queue position while status='queued' (fal) — drives the "in queue · position N" UI
  startedAt        DateTime?                         // when the job LEFT the queue and began processing — the UI's elapsed timer anchors here
  resultAssetId    String?  @db.ObjectId
  costCents        Int      @default(0)              // metered € cost, in cents
  error            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([workspaceId, status])
  @@index([workspaceId, contentProjectId])
}

//? The Remotion assembly/render job (F1.5) — composes beats+voice+images into the final
//? downloadable asset. Stub render in dummy mode.
model RenderJob {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId      String   @db.ObjectId
  contentProjectId String   @db.ObjectId
  composition      String   @default("faceless")     // the Remotion composition id
  input            Json                              // the timeline (beats + assets + timing)
  status           String   @default("queued")       // 'queued' | 'running' | 'done' | 'error'
  resultAssetId    String?  @db.ObjectId
  costCents        Int      @default(0)
  error            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([workspaceId, contentProjectId])
}

//? A named STYLE for a feature (ADR 0049 cross-cutting style system). `workspaceId` null =
//? a global default style; non-null = a per-workspace (brand) style. `systemPrompt` is the
//? curated preset a generation composes with its input + free-form extra instructions.
model StylePreset {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId  String?  @db.ObjectId                 // null = global default; set = per-workspace
  feature      String                                // the AiFeature this style applies to
  key          String                                // stable slug, e.g. 'realistisch'
  label        String
  systemPrompt String
  params       Json?                                 // optional provider/model params
  previewAssetUrl String?                            // M1 — a sample image/video showing this style's look (thumbnail gallery)
  previewKind  String?                               // M1 — 'image' | 'video' (how to render the preview)
  builtin      Boolean  @default(false)              // seeded default (not user-deletable)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId, feature])
}

//? DOC1 (DOCUMENTS_AND_SKILLS) — a workspace document: markdown SOURCE (`content`) with optional
//? render-targets (EXP exports) + attached assets. AI edits land as `aiDraft` FIRST (B-23: the
//? Conductor writes `content` only on document-apply-draft — the accept IS the consent); every
//? applied change snapshots the PREVIOUS content as a DocumentRevision (history/undo).
model Document {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId  String   @db.ObjectId
  title        String
  content      String   @default("")               // markdown source (tables inside feed the xlsx export)
  aiDraft      String?                             // pending AI proposal; null = none
  aiDraftLabel String   @default("")               // what produced the draft (mode + instruction)
  assets       Json?                               // [{ kind:'image'|'file', url, label }]
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId, archived])
}

//? DOC1 — an applied-change snapshot (the content BEFORE an apply/manual overwrite). Bounded per
//? document by the conductor (oldest pruned past 20).
model DocumentRevision {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @db.ObjectId
  documentId  String   @db.ObjectId
  content     String
  note        String   @default("")
  createdAt   DateTime @default(now())

  @@index([workspaceId, documentId])
}

//? SK1 (DOCUMENTS_AND_SKILLS) — a workspace-scoped SKILL: a reusable instruction block ("humanizer",
//? "tone-of-voice", "SEO-optimizer") injected into AI runs at its apply-points. Distinct from StylePreset
//? (per-feature render style, picked per run): a Skill is an ALWAYS-ON behavioural layer while enabled,
//? scoped by apply-point GROUPS (content/dev/designer/studio/interviewer/documents/chat/all — see
//? server/ai/skills.ts for the feature→group map). `builtin` rows are seeded per workspace, editable,
//? resettable, not deletable. The humanizer's instruction embeds the ADR-0015 integrity boundary
//? (human tone yes, AI-detection evasion never).
model Skill {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @db.ObjectId
  slug        String                                  // stable key, e.g. 'humanizer' (unique per workspace)
  name        String
  instruction String                                  // the prompt block injected at matching apply-points
  examples    String   @default("")                   // optional few-shot examples appended under the instruction
  applyPoints String[] @default([])                   // apply-point group ids; [] or ['all'] = every AI run
  enabled     Boolean  @default(false)                // OFF until the user turns it on (consent-first)
  builtin     Boolean  @default(false)                // seeded default (not deletable, instruction resettable)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId, enabled])
  @@index([workspaceId, slug])
}

//? A curated INSPIRATION/reference example a workspace collects (a great ad, thumbnail, video intro, hook).
//? The `description` ("what makes it work") is what the content AI retrieves + emulates the STRUCTURE of; the
//? optional `assetUrl` is the uploaded sample shown in the library. Distinct from StylePreset (how it renders).
model ReferenceExample {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String   @db.ObjectId
  kind        String                                   // 'ad' | 'thumbnail' | 'intro' | 'hook' | 'landing' | 'other'
  title       String
  description String                                   // why it works — the retrieval + grounding signal
  assetUrl    String?                                  // the uploaded sample (image/video), via the media upload route
  tags        String[] @default([])
  createdAt   DateTime @default(now())

  @@index([workspaceId, kind])
}

//? A metered media-spend record (ADR 0049) — one row per generation, cost in cents (€).
//? The per-workspace cap/alert + the pre-generation guard live in F0.2 (MediaBudget).
model MediaSpend {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId      String   @db.ObjectId
  contentProjectId String?  @db.ObjectId
  mediaJobId       String?  @db.ObjectId
  feature          String
  providerId       String
  costCents        Int
  createdAt        DateTime @default(now())

  @@index([workspaceId, createdAt])
}

//? H3 (ads) — a trackable short link. `/l/<slug>` records a click + 302-redirects to `targetUrl` (UTM params
//? on the short link are passed through). `variant` optionally ties a click to an A/B ad variant (H2) so the
//? metrics loop can pick a winner. The click count is the campaign's own conversion signal (no external dep).
model ShortLink {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId      String   @db.ObjectId
  contentProjectId String?  @db.ObjectId               // the ad/content piece this link promotes (optional)
  slug             String                              // the public /l/<slug> path segment (unique)
  targetUrl        String                              // where the click lands (the landing page / product)
  variant          String?                             // H2 — the A/B variant label this link represents
  clicks           Int      @default(0)
  createdAt        DateTime @default(now())

  @@unique([slug])
  @@index([workspaceId, contentProjectId])
}

//? A publish job (F3.1, ADR 0065) — a content asset posted to a platform behind the B-23 approval gate.
//? The Conductor creates it ONLY after a publish suggestion is accepted. `externalUrl` is the posted url
//? (a `stub://` fake in dummy mode / no key). `platform.notBuilt` = a future-ready platform not built yet.
model PublishJob {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId      String   @db.ObjectId
  contentProjectId String   @db.ObjectId
  assetId          String   @db.ObjectId
  platform         String                            // 'youtube' | 'tiktok' | 'instagram' | 'linkedin'
  accountId        String?                            // A3 — which connected account to publish with (null = default)
  status           String   @default("queued")       // 'queued' | 'scheduled' | 'done' | 'error'
  scheduledAt      DateTime?                          // O3 — when a 'scheduled' post should fire (null = post now)
  externalUrl      String?
  error            String?
  metrics          Json?                             // C3 — ingested audience metrics {views,likes,comments,shares,watchTimeSec,ctr,fetchedAt}
  externalId       String?                            // C3 — the platform post id (for the analytics fetch)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([workspaceId, contentProjectId])
}

//? The per-workspace media €-budget (F0.2, ADR 0051) — ONE row per workspace. `capCents`/`spentCents`
//? in cents; `enabled=false` or `capCents<=0` = no cap. The pre-generation guard (server/media/budget.ts)
//? blocks a gen that would push `spentCents` past `capCents`. Opt-in (disabled by default).
model MediaBudget {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId   String   @unique @db.ObjectId
  capCents      Int      @default(0)                // 0 or !enabled = unlimited
  alertPct      Int      @default(80)
  spentCents    Int      @default(0)                // running spend in the current window
  windowStartAt DateTime @default(now())
  enabled       Boolean  @default(false)            // opt-in
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
